# Copy this file to .env and fill in what you need, then `docker compose up`.
# docker compose reads .env automatically -- no need to source it yourself.
#
# Everything above the "Paid plans" section is the free plan. Leave
# GITULTRA_LICENSE_KEY (in that section) blank and the stack runs the
# free plan; add a license key and run `docker compose up -d` to turn on
# what your plan covers. Nothing else to switch.

# Postgres password used by every service (default: changeme, please change it).
# Only relevant if you're using the bundled Postgres container below --
# see DATABASE_URL if you're pointing at your own instead.
POSTGRES_PASSWORD=changeme

# Leave unset to use the bundled Postgres container (default). Set this
# to point every service at your own managed Postgres instead (RDS,
# Cloud SQL, Azure Database for PostgreSQL, or any other standard
# Postgres 12+ instance) -- postgres://user:pass@host:port/dbname.
# Most managed providers need `?sslmode=require` (or their own
# equivalent) appended. See docs.gitultra.com's Getting Started page,
# "Using an external database", for how to also stop running the
# bundled container once you've set this.
DATABASE_URL=

# INFO (default), DEBUG, WARNING, or ERROR. Controls verbosity of the
# structured JSON logs on stdout (see `docker compose logs`).
LOG_LEVEL=INFO

# Each service sends an anonymous usage heartbeat (no repo names, code,
# or personal data -- see the docs site's Telemetry page for exactly
# what's sent). Set to 1 to disable.
TELEMETRY_DISABLED=

# Leave unset -- works out of the box with the built-in default. Only
# set this if you have a specific reason to rotate it (not a real secret,
# just a filter against naive automated traffic against a public endpoint).
TELEMETRY_SHARED_SECRET=

# Only set the credentials for the vendor(s) you're actually importing from.
# git-processor and pr-processor each only use the ones matching the repos
# you've queued.
GITHUB_TOKEN=
GITLAB_TOKEN=
# Bitbucket Cloud: your Atlassian account email and a Bitbucket API token
# (https://support.atlassian.com/bitbucket-cloud/docs/using-api-tokens/).
# Atlassian removed app passwords in July 2026. The old names
# BITBUCKET_USERNAME / BITBUCKET_APP_PASSWORD still work for now, with a
# warning in the logs; rename them when convenient.
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=
BITBUCKET_SERVER_USERNAME=
BITBUCKET_SERVER_TOKEN=
AZURE_DEVOPS_PAT=

# Optional. Merge developers who commit under several names/emails (e.g.
# a work and a personal address) across every repo with one file in
# git's .mailmap format, one line per alias:
#   Jane Smith <jane@work.com> <jane.smith@gmail.com>
# Drop it in /var/lib/eng-metrics-suite (mounted into git-processor) and
# set this to its in-container path, e.g.
# /var/lib/eng-metrics-suite/identities.mailmap. Applies to commits
# imported from then on; to fix already-imported history, run
# reingest_repo.py --all (see the Author Identity docs page).
MAILMAP_PATH=

# Which git tags count as deployments in the DORA metrics: a regex
# matched against the tag name, e.g. ^v[0-9]. Leave blank to count every
# tag. Read by eng-reports, and by eng-api on the paid plans, so every
# report, KPI and baseline agrees. See https://docs.gitultra.com/dora-metrics/
ENG_API_TAG_PATTERN=

# --- issue-processor (optional) ---
# Only needed if you're using at least one of the two Jira-backed
# features below. Shared auth for both -- see issue-processor's README.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Change failure rate / MTTR: links Jira incidents to deployments via
# Fix Version. See jira_project_map.yaml. Comma-separated Jira
# issue-type names that count as an "incident", e.g. Incident,Bug --
# required if you want this feature (leave blank to skip it entirely).
JIRA_INCIDENT_ISSUE_TYPES=

# Investment allocation report: categorizes and tracks Jira work items.
# See allocation_projects.yaml. Comma-separated Jira issue-type names
# that count as "work" for this report, e.g. Story,Task,Bug -- required
# if you want this feature (leave blank to skip it entirely).
JIRA_ALLOCATION_ISSUE_TYPES=
# Custom field ID holding each issue's category (e.g. customfield_10032).
# Optional -- if unset, every issue's category is its Jira issue type.
JIRA_CATEGORY_FIELD=
# Custom field ID holding story points (varies per Jira instance, no
# universal default -- commonly but not always customfield_10016).
# Optional -- if unset, story-point views in the report show "n/a".
JIRA_STORY_POINTS_FIELD=

# --- Outbound email (optional) ---
# Shared by two independent features -- either or both may be unused:
#   - email_team_reports.py (see docs/scheduling.md), emailing each
#     team's report to its manager(s) automatically.
#   - eng-api's manager email-OTP verification for MCP/manager-scoped
#     access (license product "team-reporting").
# Your own SMTP relay -- never GitUltra's -- see
# gitultra-wiki/Specs/Team-Reporting-Pseudonymization.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# =====================================================================
# Paid plans (Team and Enterprise)
# =====================================================================
# Leave this whole section blank for the free plan: eng-api and
# gitultra-mcp each log one "no license key" line and idle, and the paid
# report scripts say they need a key.

# Your signed license key, issued to you directly (contact
# support@gitultra.com), not something you generate yourself. Valid for
# 90 days; a renewal is just a fresh key requested the same way. One key
# covers everything your plan includes: eng-api, gitultra-mcp, and the
# paid reports. After adding or changing it, run `docker compose up -d`.
# An invalid or expired key stops eng-api and gitultra-mcp with the
# reason in `docker compose logs`.
GITULTRA_LICENSE_KEY=

# --- eng-api ---

# Required once GITULTRA_LICENSE_KEY is set. A secret YOU choose (e.g.
# `openssl rand -hex 32`) -- not issued or stored by us, it's just what
# your own dashboards send back as Authorization: Bearer <this value>.
# See eng-api's README.
ENG_API_KEY=

# Optional. Executive Report KPI targets -- drop your CSV under
# /var/lib/eng-metrics-suite (mounted into both eng-reports and eng-api)
# and set this to its in-container path, e.g.
# /var/lib/eng-metrics-suite/kpi_targets.csv. Header: kpi,operator,target,
# optionally followed by `expected` (what you believe the value is today)
# and/or `note` (why this target). Both the PDF and
# GET /v1/executive-report read this one file. Leave blank for the
# bundled defaults. eng-api picks up edits within a minute, no restart,
# and records every change in target history.
KPI_TARGETS_PATH=

# Optional. A YAML file of dated notes about what your org changed
# (shown alongside results in reports), same mount as above, e.g.
# /var/lib/eng-metrics-suite/annotations.yaml:
#   annotations:
#     - date: 2026-02-03
#       note: Moved to a weekly on-call rotation
#       by: Jane Smith        # optional
ANNOTATIONS_PATH=

# Optional. Month your fiscal year starts (1-12, default 1 = calendar
# year). Defines the quarters baselines are measured over. A fiscal year
# is named for the year it ends (July start: Jul 2025-Jun 2026 = FY2026).
FISCAL_YEAR_START_MONTH=

# Which host port eng-api's REST API listens on.
ENG_API_PORT=8000

# Optional. eng-api already mounts /var/lib/eng-metrics-suite read-only
# (same as eng-reports above) -- drop a team-map CSV (email,team header)
# there, e.g. /var/lib/eng-metrics-suite/teams.csv, and set this to that
# in-container path. Leave blank to disable the `team` query parameter
# and team_rollup response fields.
ENG_API_TEAM_MAP_PATH=

# Optional. Enables org-level roles (Admin/Executive/Director) via the
# same email-OTP flow as manager reporting -- see
# gitultra-wiki/Specs/Org-Role-Executive-Access.md. Leave blank to
# leave this feature off entirely (no behavior change). Format:
# email,role header, role one of admin/executive/director. If you want
# to update this (or the team-map CSV above) via the admin-only
# POST /v1/admin/org-roles or /v1/admin/team-map upload endpoints
# without restarting, point this at a path under
# /var/lib/eng-metrics-suite/writable/ instead -- that's the only
# subdirectory eng-api can write to (see docker-compose.yml).
ENG_API_ORG_ROLES_PATH=

# Optional override -- see eng-api's README. Leave blank to use the
# bundled defaults. eng-reports gets the same value (and so does
# ENG_API_TEAM_MAP_PATH above), so the PDF reports and eng-api agree.
ENG_API_AI_COAUTHORS_PATH=

# Optional, Onboarding Report only: a file of extra bot account regexes
# (one per line, e.g. your CI user), added to the bundled list. Their PR
# comments and approvals don't count as review. Put it under
# /var/lib/eng-metrics-suite and use the in-container path.
BOT_PATTERNS_PATH=

# --- gitultra-mcp ---
# MCP server letting an AI agent (Claude Desktop, Claude Code, etc.)
# query the metrics above conversationally. Pure HTTP proxy to eng-api
# above -- reuses ENG_API_KEY and GITULTRA_LICENSE_KEY from that section
# (a single license key can cover both "eng-api" and "gitultra-mcp"),
# nothing new to set there. See gitultra-mcp's README for how to point
# a Claude Desktop/Code config at this.

# Which host port gitultra-mcp's streamable-HTTP endpoint listens on.
GITULTRA_MCP_PORT=8100
